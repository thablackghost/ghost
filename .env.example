# Solana Configuration
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Deployment Keypair (DO NOT COMMIT REAL KEYS)
DEPLOYMENT_KEYPAIR_PATH=~/.config/solana/id.json

# Token Configuration
GHOST_MINT_ADDRESS=
GHOST_MINT_AUTHORITY=
GHOST_ADMIN_AUTHORITY=
GHOST_METADATA_AUTHORITY=
GHOST_EMERGENCY_AUTHORITY=

# Metadata
GHOST_METADATA_URI=https://arweave.net/your-metadata-uri
GHOST_METADATA_NAME=GHOST
GHOST_METADATA_SYMBOL=GHOST

# Vanity Key Generation
VANITY_PATTERN=ghost
VANITY_CASE_INSENSITIVE=true
VANITY_KEYPAIR_PATH=./vanity-keypair.json